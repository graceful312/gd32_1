; ************************************************************
; 分散加载文件：GD32F470 IAP Bootloader
;
; Bootloader 占用 Flash 前 64KB（扇区 0-3）
; 应用程序从 0x08010000 开始
; ************************************************************

LR_IROM1 0x08000000 0x00010000  {    ; Load region: 64KB Bootloader
  ER_IROM1 0x08000000 0x00010000  {  ; Execution region
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00030000  {  ; 192KB SRAM
   .ANY (+RW +ZI)
  }
}
